# ===== 服务 =====
PORT=8787
NODE_ENV=development
# 对外可访问地址（微信授权回调必须与公众号“网页授权域名”一致，且为 https）
PUBLIC_BASE_URL=http://localhost:8787

# ===== 截止时间（不填 = 自动取最近的 11 月 24 日 24:00，北京时间）=====
# 正式活动建议写死，例如：
VOTE_DEADLINE=2026-11-24T23:59:59+08:00
VOTE_DEADLINE_LABEL=11 月 24 日 24:00

# ===== 投票窗口 =====
# calendar = 北京时间自然日一天一票（默认，每天 00:00 重置，推荐）
# rolling  = 旧版“滚动 24 小时”，仅为兼容保留，不建议再使用
VOTE_WINDOW_MODE=calendar

# ===== 后台 =====
ADMIN_PASSWORD=请改成强密码
# 不填会自动生成并保存在 data/.session-secret
SESSION_SECRET=

# ===== 数据库 =====
DB_PATH=./data/votes.db
PLAYERS_PATH=./data/players.json

# ===== 微信公众号（两项都填才启用 openid 模式；不填则回退 Cookie）=====
# 本活动由“哲样青春”公众号发布，需认证服务号 + 网页授权域名
WX_APPID=
WX_SECRET=

# ===== 防刷/限流（软限制，只防脚本洪水）=====
IP_LIMIT_WINDOW_MIN=10
IP_LIMIT_MAX=80

# 公开页是否显示实时票数（默认不显示，避免从众效应）
SHOW_COUNTS=false

# ===== 活动文案 =====
EVENT_TITLE=“指尖传薪火，巧手绘初心”
EVENT_SUBTITLE=武汉大学红色手工创作大赛 · 线上作品投票
EVENT_ORG=主办：共青团武汉大学哲学学院委员会
EVENT_ORG2=协办：共青团武汉大学社会学院委员会 · 共青团武汉大学地球与空间科学学院委员会
EVENT_SHORT=武汉大学红色手工创作大赛
